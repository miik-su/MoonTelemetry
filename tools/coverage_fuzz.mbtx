----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/io",
  "moonbitlang/async@0.22.5/gzip",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/protobuf@0.1.3",
}
----

///|
priv struct Case { mode : String; signal : String; body : Bytes }

///|
fn json(case : Case) -> Json {
  { "mode":Json::string(case.mode), "signal":Json::string(case.signal), "bodyBase64":Json::string(@protobuf.base64_encode(case.body)) }
}

///|
async fn main {
  let base_executable = "_build/native/debug/build/tests/fuzzcase/fuzzcase"
  // Moon's native artifact uses .exe on current Linux builds as well.
  let executable = if @fs.exists(base_executable+".exe") { base_executable+".exe" } else { base_executable }
  guard @fs.exists(executable) else { abort("instrumented worker is missing; run the documented build step first") }
  let rounds = if @env.get_env_var("MOONTELEMETRY_FUZZ_SMOKE") == Some("true") { 64 } else { 1024 }
  @fs.mkdir("_build/fuzz/corpus",recursive=true,allow_exist=true)
  if @fs.exists("_build/fuzz/result.json") { @fs.remove("_build/fuzz/result.json") }
  let corpus = []
  for signal in ["logs","metrics","traces"] {
    corpus.push(Case::{mode:"json",signal,body:@fs.read_file("tests/fixtures/expanded/"+signal+".json").binary()})
    corpus.push(Case::{mode:"protobuf",signal,body:b"\x0a\x00"})
  }
  corpus.push(Case::{mode:"config",signal:"logs",body:@fs.read_file("examples/collector.json").binary()})
  let compressed = @io.MemoryReader(async fn(writer) { let encoder = @gzip.Encoder(writer); encoder.write("synthetic gzip seed"); encoder.end() })
  defer compressed.close()
  corpus.push(Case::{mode:"gzip",signal:"logs",body:compressed.read_all().binary()})
  // Keep discoveries useful across clean CI runs, not only in ephemeral artifacts.
  let retained = @fs.readdir("tests/fuzz-corpus",sort=true).filter(name=>name.has_suffix(".json"))
  guard retained.length()<=128 else { abort("committed mutation seed count exceeds bound") }
  for name in retained {
    guard @json.parse(@fs.read_file("tests/fuzz-corpus/"+name).text()) is Object(fields) && fields.get("mode") is Some(String(mode)) && fields.get("signal") is Some(String(signal)) && fields.get("bodyBase64") is Some(String(encoded)) else { abort("invalid retained mutation seed") }
    let body = @protobuf.base64_decode(encoded)
    guard body.length()<=65536 else { abort("retained mutation seed exceeds input bound") }
    corpus.push(Case::{mode,signal,body})
  }
  let hits : Map[String,Bool] = Map([])
  let mut state = 0x71a34c29U
  let mut interesting = 0
  let mut accepted = 0
  for iteration in 0..<rounds {
    state = state*1664525U+1013904223U
    let base = corpus[if iteration < 8 { iteration } else { (state % corpus.length().reinterpret_as_uint()).reinterpret_as_int() }]
    let body = if iteration < 8 || iteration%11 == 0 { base.body } else {
      let length = base.body.length()
      let position = if length == 0 { 0 } else { ((state>>8)%length.reinterpret_as_uint()).reinterpret_as_int() }
      match iteration%4 {
        0 => base.body[:position].to_owned()
        1 => Bytes::from_array(Array::makei(length,i=>if i==position { base.body[i] ^ (1U<<(iteration%8)).to_byte() } else { base.body[i] }))
        2 => Bytes::from_array(Array::makei((length+1).min(65536),i=>if i<length { base.body[i] } else { (state>>24).to_byte() }))
        _ => Bytes::from_array(Array::makei(length,i=>if i==position { (state>>24).to_byte() } else { base.body[i] }))
      }
    }
    let candidate = Case::{mode:base.mode,signal:base.signal,body}
    let saved = json(candidate).stringify()+"\n"
    @fs.write_file("_build/fuzz/active-case.json",saved)
    let result = try {
      Some(@async.with_timeout(3000,async fn() { @process.collect_output(executable,["_build/fuzz/active-case.json"],no_console_window=true) }))
    } catch { _ => None }
    guard result is Some((code,stdout,_)) && code == 0 else {
      @fs.write_file("_build/fuzz/crash-case.json",saved)
      if result is Some((_,stdout,stderr)) { @fs.write_file("_build/fuzz/crash.stdout.txt",@utf8.decode_lossy(stdout.binary())); @fs.write_file("_build/fuzz/crash.stderr.txt",@utf8.decode_lossy(stderr.binary())) }
      abort("fuzz worker failed or timed out; active/crash case retained")
    }
    let output = stdout.text()
    let sections = output.split("----- BEGIN MOONBIT COVERAGE -----").collect()
    guard sections.length() >= 2 else { abort("worker must be built with --enable-coverage") }
    let counters = sections[1].to_owned().split("----- END MOONBIT COVERAGE -----").next().unwrap().trim().to_owned()
    guard @json.parse(counters) is Object(files) else { abort("invalid runtime coverage feedback") }
    let before = hits.length()
    for name,counts in files {
      if name.contains("miik-su/moontelemetry/core/data") || name.contains("miik-su/moontelemetry/config") || name.contains("miik-su/moontelemetry/receiver/otlp") {
        if counts is Array(values) { for i,value in values { if value is Number(n,..) && n>0 { hits[name+"#"+i.to_string()] = true } } }
      }
    }
    let first = output.split("\n").next().unwrap().to_owned()
    guard @json.parse(first) is Object(outcome) else { abort("missing fuzz outcome") }
    if outcome.get("accepted") == Some(Json::boolean(true)) { accepted += 1 }
    if hits.length()>before {
      interesting += 1
      @fs.write_file("_build/fuzz/corpus/case-\{iteration}.json",saved)
      if corpus.length()<256 { corpus.push(candidate) }
      if base.mode=="json" && outcome.get("wireSeed") is Some(String(encoded)) && corpus.length()<256 {
        corpus.push(Case::{mode:"protobuf",signal:base.signal,body:@protobuf.base64_decode(encoded)})
      }
    }
  }
  guard hits.length()>0 else { abort("no target coverage slots observed; refusing unguided result") }
  let report : Json = {
    "schemaVersion":1,"kind":"coverage_guided_mutation",
    "sourceRevision":Json::string(@env.get_env_var("GITHUB_SHA").unwrap_or("local-working-tree")),
    "platform":Json::string(@env.get_env_var("RUNNER_OS").unwrap_or("local")),
    "configuredCompiler":"0.10.20+65efd5b93",
    "command":"moon build tests/fuzzcase --target native --enable-coverage; moon run tools/coverage_fuzz.mbtx --target native",
    "seed":"0x71a34c29","iterations":Json::number(rounds.to_double()),
    "coveredCounterSlots":Json::number(hits.length().to_double()),"interestingInputs":Json::number(interesting.to_double()),
    "acceptedInputs":Json::number(accepted.to_double()),"crashes":0,"corpusSize":Json::number(corpus.length().to_double()),
    "feedback":"MoonBit compiler-instrumented runtime counter slots; inputs discovering new hit slots enter the mutation corpus",
    "limits":"65536 input/expanded bytes; isolated worker and per-case deadline; no ASan claim or security certification"
  }
  @fs.write_file("_build/fuzz/result.json",report.stringify()+"\n")
  println(report.stringify())
}
